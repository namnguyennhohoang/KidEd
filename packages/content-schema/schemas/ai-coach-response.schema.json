{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanhtrinhtulamduoc.local/schemas/ai-coach-response.schema.json",
  "title": "AI Coach structured response",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "child_message", "hint_level", "expected_action", "wait_seconds", "allowed_next_actions"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "INVITE_TO_START",
        "ASK_SCAFFOLDING_QUESTION",
        "OFFER_LIMITED_CHOICE",
        "REPHRASE_GOAL",
        "OFFER_VISUAL_HINT",
        "ASK_FOR_REASONING",
        "NORMALIZE_ERROR",
        "SUGGEST_STRATEGY_SWITCH",
        "ENCOURAGE_CREATIVE_DIVERGENCE",
        "BILINGUAL_BRIDGE",
        "GUIDE_BRAVE_STEP",
        "CALM_AND_RESET",
        "MOVE_OFF_SCREEN",
        "REFLECT_AND_CLOSE",
        "PARENT_HANDOFF"
      ]
    },
    "child_message": { "type": "string", "minLength": 1, "maxLength": 400 },
    "hint_level": { "type": "integer", "minimum": 0, "maximum": 6 },
    "expected_action": { "type": "string", "minLength": 1 },
    "wait_seconds": { "type": "integer", "minimum": 0, "maximum": 120 },
    "allowed_next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "safety_flag": {
      "type": ["string", "null"],
      "enum": ["NEEDS_PARENT", "DISTRESS_OBSERVED", "OUT_OF_SCOPE_QUESTION", "CONTENT_CONCERN", null]
    },
    "parent_note": { "type": ["string", "null"] }
  }
}
