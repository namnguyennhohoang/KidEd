# === Cấu hình sản phẩm (mặc định kỹ thuật, chỉnh được bởi phụ huynh/chuyên gia) ===
PRODUCT_NAME="Hành trình Tự làm được"
INITIAL_LOCALE="vi-VN"
INITIAL_STAGE="BASE_CAMP"
INITIAL_GRADE=1
DEPLOYMENT_MODE="PRIVATE_FAMILY_FIRST"

# === AI provider (pluggable, không khóa cứng 1 nhà cung cấp) ===
AI_PROVIDER="PLUGGABLE"            # PLUGGABLE | DETERMINISTIC | ANTHROPIC
ANTHROPIC_API_KEY=""               # chỉ khi AI_PROVIDER=ANTHROPIC — server-only, không commit
AI_MODEL="claude-sonnet-5"
AI_BASE_URL="https://api.anthropic.com"
AI_TIMEOUT_MS=8000
# Dù dùng LLM thật, mọi phản hồi vẫn qua AiGateway (chống injection, moderation,
# kiểm bất biến, PII, circuit breaker) + tự fallback về coach tất định nếu lỗi.

# === Cờ tính năng ===
VOICE_ENABLED=true
IMAGE_UPLOAD_ENABLED=true
VIDEO_UPLOAD_ENABLED=false
PARENT_REVIEW_REQUIRED_FOR_AI_CONTENT=true
CHILD_OPEN_CHAT_ENABLED=false
ADVERTISING_ENABLED=false
SOCIAL_SHARING_ENABLED=false

# === Nhịp học & sức khỏe ===
DEFAULT_SCREEN_SESSION_MINUTES=10
TARGET_OFFLINE_ACTIVITY_RATIO=0.7

# === Tuyển sinh & dữ liệu ===
ADMISSIONS_OVERLAYS_VISIBLE_TO_CHILD=false
DATA_USED_FOR_MODEL_TRAINING=false

# Retention (job:retention, đặt cron ở hạ tầng)
RETENTION_DAYS=1095          # phiên đã kết thúc quá hạn -> xóa (cascade)
AUDIT_RETENTION_DAYS=1095    # audit_log quá hạn -> xóa
EXPORT_TTL_DAYS=7            # file export dữ liệu -> xóa sau ngần này ngày

# === Hạ tầng (Giai đoạn 1) ===
# Dev: để trống DATABASE_URL -> dùng PGlite nhúng tại ./data/pglite
# Production: đặt URL Postgres thật, vd postgres://tiny:tiny@localhost:5432/tiny
DATABASE_URL=""
PGLITE_DATA_DIR="./data/pglite"
REDIS_URL=""

# Dev: STORAGE_DRIVER=filesystem -> lưu ./data/uploads
# Production: STORAGE_DRIVER=s3
STORAGE_DRIVER="filesystem"
STORAGE_FS_DIR="./data/uploads"
S3_ENDPOINT=""
S3_BUCKET="tiny-artifacts"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

API_PORT=4000
WEB_PORT=3000

# === Auth ===
SESSION_SECRET=""                 # chuỗi ngẫu nhiên dài, chỉ ở server
PARENT_DASHBOARD_PIN_REQUIRED=true
