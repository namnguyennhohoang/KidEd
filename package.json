{
  "name": "hanh-trinh-tu-lam-duoc",
  "private": true,
  "version": "0.0.0",
  "description": "Nền tảng giáo dục AI cá nhân hóa cho trẻ - Hành trình Tự làm được",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "validate:content": "node packages/content-schema/validate.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "job:retention": "npm run job:retention --workspace apps/api",
    "api": "npm run dev --workspace apps/api",
    "web": "npm run dev --workspace apps/web",
    "dev": "npm run dev --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "e2e": "npm run e2e --workspace apps/web",
    "e2e:install": "npm run e2e:install --workspace apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
